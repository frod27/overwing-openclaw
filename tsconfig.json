{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["node"],
    "paths": { "openclaw/plugin-sdk/*": ["/opt/homebrew/lib/node_modules/openclaw/dist/plugin-sdk/*"] }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
