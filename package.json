{
  "name": "overwing-openclaw",
  "version": "0.1.0",
  "description": "OpenClaw plugin: Overwing's send gate on every outbound message, reply and tool call. Shadow mode by default; pays per check with an API key, an x402 wallet (ClawRouter's works), or the free allowance.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": { "import": "./dist/index.js", "types": "./dist/index.d.ts" }
  },
  "files": ["dist", "!dist/**/*.map", "skills", "openclaw.plugin.json", "openclaw.security.json", "docs/*.md"],
  "openclaw": {
    "extensions": ["./dist/index.js"],
    "compat": { "pluginApiRange": ">=2026.3.24", "minGatewayVersion": "2026.5.2" }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"src/**/*.test.ts\"",
    "pack:local": "npm run build && npm pack --pack-destination /tmp"
  },
  "keywords": ["openclaw", "openclaw-plugin", "guardrails", "x402", "agents", "moderation", "pii"],
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/frod27/overwing-openclaw" },
  "homepage": "https://overwing.ai/gate",
  "engines": { "node": ">=22" },
  "peerDependencies": { "openclaw": ">=2026.3.24" },
  "peerDependenciesMeta": { "openclaw": { "optional": true } },
  "dependencies": {
    "@x402/evm": "^2.9.0",
    "@x402/fetch": "^2.9.0",
    "viem": "^2.39.3"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "@types/node": "^22.0.0"
  }
}
